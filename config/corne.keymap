#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

&mmv {
    delay-ms = <0>;
    time-to-max-speed-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        parentheses_left {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
        };

        parentheses_right {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <21 22>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
        };

        square_brackets_left {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <19 21>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
        };

        square_brackets_right {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <20 22>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
        };

        aphostrophe {
            bindings = <&kp SQT>;
            key-positions = <9 10>;
        };
    };

    behaviors {
        hold_tap_left: hold_tap_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;
            require-prior-idle-ms = <170>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 20 8 9 10 11 23 22 30 31 32 33 34 35 39 40 41 6 18 19 20 21 37 36 38>;
        };

        hold_tap_right: hold_tap_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <169>;
            require-prior-idle-ms = <170>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <38 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
        };

        layer_homerow: layer_homerow {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOMEROW";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            flavor = "tap-preferred";
            quick-tap-ms = <175>;
        };

        sunaku_sticky: sunaku_sticky {
            compatible = "zmk,behavior-sticky-key";
            label = "SUNAKU_STICKY";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
        };

        bootloader_tapdance: bootloader_tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "BOOTLOADER_TAPDANCE";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };

        holdtapwindow: holdtapwindow {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAPWINDOW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
        };
    };

    macros {
        translate: translate {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp C &kp B &kp V>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "TRANSLATE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Default";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp GRAVE                  &kp Q  &kp W  &kp E                  &kp R                   &kp T            &kp Y  &kp U                          &kp I                    &kp O    &kp P          &kp DELETE
&kp LEFT_ALT               &kp A  &kp S  &kp D                  &kp F                   &kp G            &kp H  &hold_tap_right RIGHT_SHIFT J  &hold_tap_right RCTRL K  &kp L    &kp SEMICOLON  &kp SQT
&layer_homerow 2 LEFT_GUI  &kp Z  &kp X  &kp C                  &kp V                   &kp B            &kp N  &kp M                          &kp COMMA                &kp DOT  &kp SLASH      &layer_homerow 5 ENTER
                                         &mt LEFT_SHIFT ESCAPE  &layer_homerow 1 SPACE  &mt LCTRL TAB    &mo 4  &kp BACKSPACE                  &mo 3
            >;

            label = "Base";
        };

        Nav {
            bindings = <
&trans  &kp BACKSPACE   &trans          &kp UP_ARROW    &trans           &kp PRINTSCREEN    &kp K_REDO    &kp K_PASTE      &kp K_COPY   &kp K_CUT      &kp K_UNDO     &trans
&trans  &kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans             &kp CAPSLOCK  &kp RIGHT_SHIFT  &kp RCTRL    &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
&trans  &kp LCTRL       &trans          &trans          &trans           &trans             &kp INSERT    &kp HOME         &kp PAGE_UP  &kp PAGE_DOWN  &kp END        &trans
                                        &to 2           &trans           &trans             &kp RETURN    &kp BACKSPACE    &kp DELETE
            >;

            label = "Nav";
        };

        Media {
            bindings = <
&none   &none          &trans        &trans             &trans           &none         &rgb_ug RGB_TOG   &rgb_ug RGB_EFF  &rgb_ug RGB_HUI    &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &trans
&trans  &kp C_BRI_DEC  &kp C_BRI_UP  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_MUTE    &out OUT_TOG      &kp C_PREVIOUS   &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT       &none
&trans  &trans         &trans        &none              &none            &none         &bt BT_CLR        &bt BT_SEL 0     &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3     &trans
                                     &trans             &trans           &trans        &kp C_PLAY_PAUSE  &kp K_STOP       &kp C_MUTE
            >;

            label = "Media";
        };

        Sym {
            bindings = <
&none   &kp LBRC   &kp AMPS  &kp STAR     &kp LEFT_PARENTHESIS  &kp RBRC          &trans  &trans                      &trans                &trans                    &trans                    &trans
&trans  &kp SQT    &kp DLLR  &kp PRCNT    &kp CARET             &kp PLUS          &trans  &sunaku_sticky RIGHT_SHIFT  &sunaku_sticky RCTRL  &sunaku_sticky RIGHT_ALT  &sunaku_sticky RIGHT_GUI  &trans
&trans  &kp TILDE  &kp EXCL  &kp AT_SIGN  &kp POUND             &trans            &trans  &trans                      &trans                &trans                    &trans                    &trans
                             &kp LPAR     &kp RPAR              &kp UNDERSCORE    &trans  &trans                      &trans
            >;

            label = "Sym";
        };

        Num {
            bindings = <
&trans  &kp LBKT           &kp N7  &kp N8   &kp N9  &kp RBKT     &none   &none                       &trans                &trans                    &trans                    &trans
&trans  &kp DOUBLE_QUOTES  &kp N4  &kp N5   &kp N6  &kp EQUAL    &trans  &sunaku_sticky RIGHT_SHIFT  &sunaku_sticky RCTRL  &sunaku_sticky RIGHT_ALT  &sunaku_sticky RIGHT_GUI  &trans
&trans  &kp GRAVE          &kp N1  &kp N2   &kp N3  &kp BSLH     &trans  &trans                      &trans                &trans                    &trans                    &trans
                                   &kp DOT  &kp N0  &kp MINUS    &trans  &kp BACKSPACE               &trans
            >;

            label = "Num";
        };

        Fun {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8     &kp F9     &kp PRINTSCREEN    &trans  &trans                      &trans                &trans                    &trans                    &trans
&trans  &kp F11  &kp F4  &kp F5     &kp F6     &kp SCROLLLOCK     &trans  &sunaku_sticky RIGHT_SHIFT  &sunaku_sticky RCTRL  &sunaku_sticky RIGHT_ALT  &sunaku_sticky RIGHT_GUI  &trans
&trans  &kp F10  &kp F1  &kp F2     &kp F3     &kp PAUSE_BREAK    &trans  &trans                      &trans                &trans                    &trans                    &trans
                         &kp K_APP  &kp SPACE  &kp TAB            &trans  &trans                      &trans
            >;

            label = "Fun";
        };

        Lol {
            bindings = <
&trans  &kp Q  &kp W  &kp E           &kp R      &kp T        &kp Y  &kp U          &kp I      &kp O    &kp P     &trans
&trans  &kp A  &kp S  &kp D           &kp F      &kp G        &kp H  &kp J          &kp K      &kp L    &kp APOS  &trans
&trans  &kp Z  &kp X  &kp C           &kp V      &kp B        &kp N  &kp M          &kp COMMA  &kp DOT  &kp FSLH  &trans
                      &kp LEFT_SHIFT  &kp SPACE  &kp LCTRL    &to 0  &kp RIGHT_GUI  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Lol {
            if-layers = <1 2>;
            then-layer = <6>;
        };
    };
};
