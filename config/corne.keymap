#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv {
    delay-ms = <0>;
    time-to-max-speed-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        parentheses_left {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
        };

        parentheses_right {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <21 22>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
        };

        square_brackets_left {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <19 21>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
        };

        square_brackets_right {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <20 22>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
        };
    };

    behaviors {
        hold_tap_left: hold_tap_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 20 8 9 10 11 23 22 30 31 32 33 34 35 39 40 41 6 18 19 20 21 37 36 38>;
        };

        hold_tap_right: hold_tap_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <38 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
        };

        layer_homerow: layer_homerow {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOMEROW";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            flavor = "tap-preferred";
            quick-tap-ms = <175>;
        };

        sunaku_sticky: sunaku_sticky {
            compatible = "zmk,behavior-sticky-key";
            label = "SUNAKU_STICKY";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
        };

        bootloader_tapdance: bootloader_tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "BOOTLOADER_TAPDANCE";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Default";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none  &kp Q                      &kp W                      &kp E                   &kp R                        &kp T                   &kp Y                   &kp U                          &kp I                    &kp O                        &kp P                                 &none
&none  &hold_tap_left LEFT_GUI A  &hold_tap_left LEFT_ALT S  &hold_tap_left LCTRL D  &hold_tap_left LEFT_SHIFT F  &kp G                   &kp H                   &hold_tap_right RIGHT_SHIFT J  &hold_tap_right RCTRL K  &hold_tap_right RIGHT_ALT L  &hold_tap_right RIGHT_GUI APOSTROPHE  &none
&none  &layer_homerow 4 Z         &kp X                      &kp C                   &kp V                        &kp B                   &kp N                   &kp M                          &kp COMMA                &kp DOT                      &layer_homerow 4 SLASH                &none
                                                             &layer_homerow 3 ESC    &layer_homerow 2 SPACE       &layer_homerow 1 TAB    &layer_homerow 5 ENTER  &layer_homerow 6 BACKSPACE     &layer_homerow 7 DELETE
            >;

            label = "Base";
        };

        Mouse {
            bindings = <
&trans  &trans                   &trans                   &trans                &trans                     &kp PRINTSCREEN    &kp K_REDO  &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO       &trans
&trans  &sunaku_sticky LEFT_GUI  &sunaku_sticky LEFT_ALT  &sunaku_sticky LCTRL  &sunaku_sticky LEFT_SHIFT  &trans             &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans                   &trans                   &trans                &trans                     &trans             &trans      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                                                          &trans                &trans                     &trans             &mkp RCLK   &mkp LCLK       &mkp MCLK
            >;

            label = "Mouse";
        };

        Nav {
            bindings = <
&trans  &trans                   &trans                   &trans                &trans                     &trans    &kp K_REDO    &kp K_PASTE     &kp K_COPY      &kp K_CUT      &kp K_UNDO       &trans
&trans  &sunaku_sticky LEFT_GUI  &sunaku_sticky LEFT_ALT  &sunaku_sticky LCTRL  &sunaku_sticky LEFT_SHIFT  &trans    &kp CAPSLOCK  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT_ARROW  &trans
&trans  &trans                   &trans                   &trans                &trans                     &trans    &kp INSERT    &kp HOME        &kp PAGE_UP     &kp PAGE_DOWN  &kp END          &trans
                                                          &trans                &trans                     &trans    &kp RETURN    &kp BACKSPACE   &kp DELETE
            >;

            label = "Nav";
        };

        Media {
            bindings = <
&none   &bt BT_CLR               &trans                   &trans                &trans                     &trans    &rgb_ug RGB_TOG    &rgb_ug RGB_EFF  &rgb_ug RGB_HUI    &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &trans
&trans  &sunaku_sticky LEFT_GUI  &sunaku_sticky LEFT_ALT  &sunaku_sticky LCTRL  &sunaku_sticky LEFT_SHIFT  &trans    &ext_power EP_TOG  &kp C_PREVIOUS   &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT       &none
&trans  &trans                   &trans                   &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC       &none     &out OUT_TOG       &bt BT_SEL 0     &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3     &trans
                                                          &trans                &trans                     &trans    &kp C_PAUSE        &kp C_STOP       &kp C_MUTE
            >;

            label = "Media";
        };

        Button {
            bindings = <
&none   &kp K_UNDO               &kp K_CUT                &kp K_COPY            &kp K_PASTE                &kp K_REDO    &kp K_REDO  &kp K_PASTE                 &kp K_COPY            &kp K_CUT                 &kp K_UNDO                &trans
&trans  &sunaku_sticky LEFT_GUI  &sunaku_sticky LEFT_ALT  &sunaku_sticky LCTRL  &sunaku_sticky LEFT_SHIFT  &trans        &trans      &sunaku_sticky RIGHT_SHIFT  &sunaku_sticky RCTRL  &sunaku_sticky RIGHT_ALT  &sunaku_sticky RIGHT_GUI  &trans
&trans  &kp K_UNDO               &kp K_CUT                &kp K_COPY            &kp K_PASTE                &kp K_REDO    &kp K_REDO  &kp K_PASTE                 &kp K_COPY            &kp K_CUT                 &kp K_UNDO                &trans
                                                          &mkp MCLK             &mkp LCLK                  &mkp RCLK     &mkp RCLK   &mkp LCLK                   &mkp MCLK
            >;

            label = "Button";
        };

        Sym {
            bindings = <
&none   &kp LBRC   &kp AMPS  &kp STAR     &kp LEFT_PARENTHESIS  &kp RBRC          &trans  &trans                      &trans                &trans                    &trans                    &trans
&trans  &kp COLON  &kp DLLR  &kp PRCNT    &kp CARET             &kp PLUS          &trans  &sunaku_sticky RIGHT_SHIFT  &sunaku_sticky RCTRL  &sunaku_sticky RIGHT_ALT  &sunaku_sticky RIGHT_GUI  &trans
&trans  &kp TILDE  &kp EXCL  &kp AT_SIGN  &kp POUND             &trans            &trans  &trans                      &trans                &trans                    &trans                    &trans
                             &kp LPAR     &kp RPAR              &kp UNDERSCORE    &trans  &trans                      &trans
            >;

            label = "Sym";
        };

        Num {
            bindings = <
&trans  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &none   &none                       &trans                &trans                    &trans                    &trans
&trans  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &trans  &sunaku_sticky RIGHT_SHIFT  &sunaku_sticky RCTRL  &sunaku_sticky RIGHT_ALT  &sunaku_sticky RIGHT_GUI  &trans
&trans  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &trans  &trans                      &trans                &trans                    &trans                    &trans
                           &kp DOT  &kp N0  &kp MINUS    &trans  &trans                      &trans
            >;

            label = "Num";
        };

        Fun {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8     &kp F9     &kp PRINTSCREEN    &trans  &trans                      &trans                &trans                    &trans                    &trans
&trans  &kp F11  &kp F4  &kp F5     &kp F6     &kp SCROLLLOCK     &trans  &sunaku_sticky RIGHT_SHIFT  &sunaku_sticky RCTRL  &sunaku_sticky RIGHT_ALT  &sunaku_sticky RIGHT_GUI  &trans
&trans  &kp F10  &kp F1  &kp F2     &kp F3     &kp PAUSE_BREAK    &trans  &trans                      &trans                &trans                    &trans                    &trans
                         &kp K_APP  &kp SPACE  &kp TAB            &trans  &trans                      &trans
            >;

            label = "Fun";
        };

        Adjust {
            bindings = <
&trans  &bootloader_tapdance  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                      &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Adjust";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
